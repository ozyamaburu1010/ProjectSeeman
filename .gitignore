# ===== Unity =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data — only ignore meta for files we *don't* keep
!/[Aa]ssets/**/*.meta

# Generated C# project / solution files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash / build reports
sysinfo.txt
*.stackdump
crashlog.txt
/[Bb]uild[Rr]eport*/
*.app

# OS / IDE cruft
.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/

# ===== Project Seeman specific =====

# Throwaway capture artifacts
/Assets/Screenshots/
/Assets/Screenshots.meta

# Local AI sidecar: huge & reconstructable (setup.ps1 rebuilds these)
#   - Python virtualenvs
#   - Irodori-TTS upstream repo (cloned by setup.ps1, has its own .git)
/Assets/StreamingAssets/SeemanServer/.venv/
/Assets/StreamingAssets/SeemanServer/.venv-rocm/
/Assets/StreamingAssets/SeemanServer/Irodori-TTS/
/Assets/StreamingAssets/SeemanServer/Irodori-TTS.meta

# Machine-generated runtime config (regenerated by setup.ps1 from VRAM detection).
# The committed config_default.json is the template.
/Assets/StreamingAssets/SeemanServer/config.json
/Assets/StreamingAssets/SeemanServer/config.json.meta

# Persistent local model caches if any land in-tree
__pycache__/
*.pyc
